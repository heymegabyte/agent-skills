{
  "id": "voicekit",
  "name": "VoiceKit ($17k Credits Voice Agents & TTS)",
  "description": "Primary hosted Voice Agents, Two-Host Podcast Studio, High-Fidelity TTS, and Realtime Transcription via VoiceKit ($17,000 startup credits grant; replaces ElevenLabs).",
  "categories": ["voice"],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "setup": {
    "requiresRuntime": false,
    "providers": [
      {
        "id": "voicekit",
        "envVars": ["VOICEKIT_API_KEY"]
      }
    ]
  },
  "contracts": {
    "speechProviders": ["voicekit"],
    "mediaUnderstandingProviders": ["voicekit"],
    "realtimeTranscriptionProviders": ["voicekit"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiBaseUrl": {
        "type": "string"
      },
      "creditsTierUsd": {
        "type": "number"
      },
      "defaultVoiceHostA": {
        "type": "string"
      },
      "defaultVoiceHostB": {
        "type": "string"
      },
      "fallbackChain": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
