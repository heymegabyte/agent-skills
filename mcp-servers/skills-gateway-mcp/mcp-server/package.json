{
  "name": "skills-gateway-mcp",
  "version": "1.1.0",
  "description": "MCP Gateway that indexes every heymegabyte/agent-skills skill, rule, and agent behind 3 meta-tools — cuts skill context from ~50K tokens to ~1K",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "skills-gateway-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "measure": "node dist/measure.js",
    "measure:json": "node dist/measure.js --json",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
