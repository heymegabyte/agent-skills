{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "catalog_version", "source", "families"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "catalog_version": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "families": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "name", "recommendations"],
        "properties": {
          "id": { "pattern": "^F(?:0[1-9]|1[0-5])$" },
          "name": { "type": "string" },
          "recommendations": {
            "type": "array",
            "minItems": 30,
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "directive",
                "policy_state",
                "rollout_state",
                "applicability",
                "priority",
                "layer",
                "execution_tier",
                "pass_criteria",
                "evidence"
              ],
              "properties": {
                "id": { "pattern": "^F(?:0[1-9]|1[0-5])\\.(?:0[1-9]|[12][0-9]|30)$" },
                "title": { "type": "string", "minLength": 3 },
                "directive": { "type": "string", "minLength": 12 },
                "policy_state": {
                  "enum": ["implemented", "verified", "planned", "blocked", "not_applicable"]
                },
                "rollout_state": {
                  "enum": ["implemented", "verified", "planned", "blocked", "not_applicable"]
                },
                "evidence": { "type": "array" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
