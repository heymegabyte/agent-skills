{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "application", "revision", "requirements"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "application": { "type": "string" },
    "revision": { "type": "string" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "invariant",
          "catalog_ids",
          "owner",
          "risk",
          "applicability",
          "tests",
          "dependencies",
          "tier",
          "state",
          "evidence"
        ],
        "properties": {
          "catalog_ids": {
            "type": "array",
            "items": { "pattern": "^F(?:0[1-9]|1[0-5])\\.(?:0[1-9]|[12][0-9]|30)$" }
          },
          "state": { "enum": ["planned", "implemented", "verified", "blocked", "not_applicable"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
