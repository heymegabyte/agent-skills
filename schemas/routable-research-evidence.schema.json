{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.megabyte.space/schemas/routable-research-evidence.schema.json",
  "title": "Routable Research Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "tenantId",
    "environmentId",
    "generatedAt",
    "expiresAt",
    "readiness",
    "evidence",
    "contradictions",
    "unresolvedQuestions",
    "budgetStatus",
    "integrityDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactId": { "$ref": "#/$defs/identifier" },
    "tenantId": { "$ref": "#/$defs/identifier" },
    "environmentId": { "$ref": "#/$defs/identifier" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "readiness": {
      "enum": ["declared", "locally_tested", "sandbox_verified", "production_observed"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/contradiction" }
    },
    "unresolvedQuestions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "budgetStatus": { "enum": ["within_budget", "partial", "exhausted", "cancelled"] },
    "integrityDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "identifierArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skillIds",
        "routingTags",
        "sourceVersion",
        "researchDate",
        "citationIds",
        "confidence",
        "contradictionIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "skillIds": { "$ref": "#/$defs/identifierArray" },
        "routingTags": { "$ref": "#/$defs/identifierArray" },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
        "researchDate": { "type": "string", "format": "date" },
        "citationIds": {
          "allOf": [{ "$ref": "#/$defs/identifierArray" }, { "minItems": 1 }]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "contradictionIds": { "$ref": "#/$defs/identifierArray" }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  }
}
