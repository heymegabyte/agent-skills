{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/durability-evaluation-report.schema.json",
  "title": "Durability fault evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluationId",
    "taskId",
    "generatedAt",
    "evidenceStrength",
    "scenarios",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evaluationId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "taskId": { "const": "10.2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "evidenceStrength": { "const": "controlled-deterministic-simulation" },
    "scenarios": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "scenarioIds"],
      "properties": {
        "total": { "type": "integer", "minimum": 6 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "scenarioIds": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "fault", "status", "observations"],
      "properties": {
        "scenarioId": {
          "enum": [
            "interruption-resume",
            "duplicate-dispatch",
            "competing-writers",
            "blocked-release",
            "remote-main-advance",
            "maintenance-recursion"
          ]
        },
        "fault": { "type": "string", "minLength": 1 },
        "status": { "const": "pass" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "state", "ownership", "evidence", "nextAction"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "stateDigest", "checkpointRef", "blockedEdges"],
          "properties": {
            "disposition": { "type": "string", "minLength": 1 },
            "stateDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "checkpointRef": { "type": "string", "minLength": 1 },
            "blockedEdges": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "activeOwner", "waitingOwners", "taskOwners"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "activeOwner": { "type": "string" },
            "waitingOwners": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "taskOwners": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceId", "digest", "observation"],
            "properties": {
              "evidenceId": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "observation": { "type": "string", "minLength": 1 }
            }
          }
        },
        "nextAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "target", "resumable"],
          "properties": {
            "action": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "resumable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
