      "packages": ["@theme.tools/sdk", "@theme.tools/telemetry"],
      "consumerOwns": ["task policy", "product configuration"],
      "contributeWhen": ["shared agent or application workflow emerges"]
    },
    "02-goal-and-brief": {
      "packages": ["@theme.tools/catalog", "@theme.tools/sdk"],
      "consumerOwns": ["business brief", "product decisions"],
      "contributeWhen": ["reusable brief schema or estimator emerges"]
    },
    "04-preference-and-memory": {
      "packages": ["@theme.tools/agent-memory", "@theme.tools/auth"],
